<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/colorSurface"
    android:padding="@dimen/spacing_2xl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="@dimen/spacing_lg">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_check_circle"
            app:tint="@color/colorStatusCompleted"
            android:contentDescription="@string/success"
            android:layout_marginEnd="@dimen/spacing_md"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/wifi_success_title"
            android:textSize="@dimen/text_size_xl"
            android:textStyle="bold"
            android:textColor="@color/colorTextPrimary"
            android:letterSpacing="-0.02"/>

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/device_is_now_connected_to"
        android:textSize="@dimen/text_size_md"
        android:textColor="@color/colorTextSecondary"
        android:layout_marginBottom="@dimen/spacing_md"/>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_lg"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/colorAccentSurface"
        app:strokeWidth="1dp"
        app:strokeColor="@color/colorAccentLight">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/spacing_sm">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/network"
                    android:textSize="@dimen/text_size_sm"
                    android:textColor="@color/colorTextMuted"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"/>

                <TextView
                    android:id="@+id/tvWifiSsid"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/network_name"
                    android:textSize="@dimen/text_size_body_sm"
                    android:textColor="@color/colorTextPrimary"
                    android:textStyle="bold"
                    android:gravity="end"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/device_ip"
                    android:textSize="@dimen/text_size_sm"
                    android:textColor="@color/colorTextMuted"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"/>

                <TextView
                    android:id="@+id/tvDeviceIp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/text_192_168_x_x"
                    android:textSize="@dimen/text_size_body_sm"
                    android:textColor="@color/colorTextPrimary"
                    android:textStyle="bold"
                    android:gravity="end"
                    android:fontFamily="monospace"/>

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/you_can_now_reconnect_your"
        android:textSize="@dimen/text_size_body_sm"
        android:textColor="@color/colorTextSecondary"
        android:lineSpacingExtra="2dp"
        android:layout_marginBottom="@dimen/spacing_xl" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStayHere"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:text="@string/btn_stay_here"
            android:textSize="@dimen/text_size_body_sm"
            style="@style/Widget.SmartPetFeeder.Button.Outlined" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDone"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/btn_done"
            android:textSize="@dimen/text_size_body_sm"
            style="@style/Widget.SmartPetFeeder.Button" />

    </LinearLayout>

</LinearLayout>
