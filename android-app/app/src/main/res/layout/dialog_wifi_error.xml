<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/colorSurface"
    android:padding="@dimen/spacing_2xl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="@dimen/spacing_lg">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_error"
            app:tint="@color/colorStatusMissed"
            android:contentDescription="@string/error"
            android:layout_marginEnd="@dimen/spacing_md"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/wifi_failure_title"
            android:textSize="@dimen/text_size_xl"
            android:textStyle="bold"
            android:textColor="@color/colorTextPrimary"
            android:letterSpacing="-0.02"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="@dimen/spacing_lg">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/could_not_connect_to"
            android:textSize="@dimen/text_size_body_sm"
            android:textColor="@color/colorTextSecondary"
            android:layout_marginBottom="@dimen/spacing_sm"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/colorCardAlert"
            app:strokeWidth="1dp"
            app:strokeColor="@color/colorStatusMissed">

            <TextView
                android:id="@+id/tvWifiSsid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/network_name"
                android:textSize="@dimen/text_size_md"
                android:textColor="@color/colorTextPrimary"
                android:textStyle="bold"
                android:padding="14dp"/>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/reason"
            android:textSize="@dimen/text_size_sm"
            android:textColor="@color/colorTextMuted"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_marginBottom="@dimen/spacing_sm"/>

        <TextView
            android:id="@+id/tvErrorReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/connection_error_message"
            android:textSize="@dimen/text_size_body_sm"
            android:textColor="@color/colorStatusMissed"
            android:lineSpacingExtra="2dp"/>

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/please_check_the_network_name"
        android:textSize="@dimen/text_size_body_sm"
        android:textColor="@color/colorTextSecondary"
        android:lineSpacingExtra="2dp"
        android:layout_marginBottom="@dimen/spacing_xl"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRetry"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="@string/btn_try_again"
        android:textSize="@dimen/text_size_md"
        android:textStyle="bold"
        style="@style/Widget.SmartPetFeeder.Button"/>

</LinearLayout>
