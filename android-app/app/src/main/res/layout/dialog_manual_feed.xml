<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/spacing_2xl"
    android:paddingEnd="@dimen/spacing_2xl"
    android:paddingTop="@dimen/spacing_sm">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Choose how much food to dispense."
        android:textSize="14sp"
        android:textColor="@color/colorTextSecondary"
        android:layout_marginBottom="18dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPortionDecrease"
            style="@style/Widget.SmartPetFeeder.Button.Outlined"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:text="−"
            android:textSize="22sp"
            android:contentDescription="Decrease portion by 5 grams"/>

        <EditText
            android:id="@+id/etManualPortion"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="10dp"
            android:background="@drawable/bg_input_field"
            android:gravity="center"
            android:inputType="numberDecimal"
            android:selectAllOnFocus="true"
            android:maxLength="6"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/colorTextPrimary"
            android:importantForAutofill="no"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="g"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/colorTextSecondary"
            android:layout_marginEnd="10dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPortionIncrease"
            style="@style/Widget.SmartPetFeeder.Button.Outlined"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:text="+"
            android:textSize="22sp"
            android:contentDescription="Increase portion by 5 grams"/>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Use the buttons for 5 g steps, or enter an amount."
        android:textSize="12sp"
        android:textColor="@color/colorTextMuted"/>
</LinearLayout>
