<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_xl"
        android:paddingEnd="@dimen/spacing_xl"
        android:paddingTop="@dimen/spacing_2xl"
        android:paddingBottom="@dimen/spacing_4xl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/spacing_2xl">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="10dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_backspace"
                app:tint="@color/colorTextPrimary"
                android:contentDescription="@string/back"/>

            <View
                android:layout_width="3dp"
                android:layout_height="18dp"
                android:background="@color/colorPrimary"
                android:layout_marginEnd="10dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wifi_config_title"
                android:textSize="@dimen/text_size_title"
                android:textStyle="bold"
                android:textColor="@color/colorTextPrimary"
                android:letterSpacing="-0.01"/>

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status"
            android:textSize="@dimen/text_size_caption"
            android:textStyle="bold"
            android:textColor="@color/colorTextLabel"
            android:letterSpacing="0.10"
            android:layout_marginBottom="@dimen/spacing_sm"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_xl"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/colorSurface"
            app:strokeWidth="1dp"
            app:strokeColor="@color/colorDivider">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/spacing_xl"
                android:paddingEnd="@dimen/spacing_xl"
                android:paddingTop="18dp"
                android:paddingBottom="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvWifiModeLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/wifi_searching"
                            android:textColor="@color/colorPrimary"
                            android:textSize="@dimen/text_size_body"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/tvDeviceStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:lineSpacingExtra="2dp"
                            android:text="@string/looking_for_your_pet_feeder"
                            android:textColor="@color/colorTextMuted"
                            android:textSize="@dimen/text_size_body_sm"/>

                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/progressBarWifi"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="@dimen/spacing_lg"
                        android:indeterminateTint="@color/colorPrimary"
                        android:visibility="visible"/>

                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/cardInstructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_xl"
            android:visibility="gone"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/colorCardWarning"
            app:strokeWidth="1dp"
            app:strokeColor="@color/colorDivider">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/spacing_lg"
                android:paddingEnd="@dimen/spacing_lg"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_warning"
                    app:tint="@color/colorStatusWarning"
                    android:contentDescription="@string/instructions"
                    android:layout_marginEnd="@dimen/spacing_md"
                    android:layout_gravity="top"
                    android:layout_marginTop="2dp"/>

                <TextView
                    android:id="@+id/tvInstructions"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/wifi_setup_instructions"
                    android:textSize="@dimen/text_size_body_sm"
                    android:textColor="@color/colorTextSecondary"
                    android:visibility="gone"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/credentials"
            android:textSize="@dimen/text_size_caption"
            android:textStyle="bold"
            android:textColor="@color/colorTextLabel"
            android:letterSpacing="0.10"
            android:layout_marginBottom="@dimen/spacing_sm"/>

        <androidx.cardview.widget.CardView
            android:id="@+id/layoutConfigForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_xl"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/colorSurface"
            app:strokeWidth="1dp"
            app:strokeColor="@color/colorDivider"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/spacing_xl"
                android:paddingEnd="@dimen/spacing_xl"
                android:paddingTop="18dp"
                android:paddingBottom="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/spacing_md">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/wifi_ssid_hint"
                        style="@style/Widget.SmartPetFeeder.TextInputLayout">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etWifiSsid"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionNext"
                            android:inputType="text"
                            android:maxLines="1"
                            android:textSize="@dimen/text_size_md"
                            android:textColor="@color/colorTextPrimary"/>

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAutoDetectSsid"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:text="@string/btn_auto_detect_ssid"
                        android:textSize="@dimen/text_size_sm"
                        style="@style/Widget.SmartPetFeeder.Button.Outlined"/>

                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_xl"
                    android:hint="@string/wifi_password_hint"
                    app:endIconMode="password_toggle"
                    style="@style/Widget.SmartPetFeeder.TextInputLayout">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etWifiPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:textSize="@dimen/text_size_md"
                        android:textColor="@color/colorTextPrimary"/>

                </com.google.android.material.textfield.TextInputLayout>

                <ImageButton
                    android:id="@+id/btnTogglePassword"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/toggle_password_visibility"
                    android:visibility="gone"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnScanWifiQr"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="10dp"
                    android:text="@string/btn_scan_wifi_qr"
                    android:textSize="@dimen/text_size_md"
                    style="@style/Widget.SmartPetFeeder.Button.Outlined"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConfigureDevice"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="10dp"
                    android:text="@string/btn_configure_device"
                    android:textSize="@dimen/text_size_body"
                    android:textStyle="bold"
                    style="@style/Widget.SmartPetFeeder.Button"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFindDevice"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="@dimen/spacing_sm"
                    android:text="@string/btn_find_device"
                    android:textSize="@dimen/text_size_md"
                    style="@style/Widget.SmartPetFeeder.Button.Outlined"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnResetWifi"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="@string/btn_reset_wifi"
                    android:textSize="@dimen/text_size_md"
                    android:visibility="gone"
                    style="@style/Widget.SmartPetFeeder.Button.Destructive"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <View
            android:layout_width="match_parent"
            android:layout_height="24dp"/>

    </LinearLayout>
</ScrollView>
