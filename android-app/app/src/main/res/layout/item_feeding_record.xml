<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardFeedingRecord"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/colorSurface"
    app:strokeWidth="1dp"
    app:strokeColor="@color/colorDivider">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <View
            android:id="@+id/statusAccent"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="@color/colorPrimary"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="10dp"
            android:paddingTop="13dp"
            android:paddingBottom="13dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:id="@+id/tvScheduledTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Scheduled: 08:00"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorTextPrimary"
                    android:layout_marginEnd="14dp"/>

                <TextView
                    android:id="@+id/tvActualTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Actual: 08:04"
                    android:textSize="12sp"
                    android:textColor="@color/colorTextMuted"/>

            </LinearLayout>

            <TextView
                android:id="@+id/tvTargetWeight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Target: 80.0g"
                android:textSize="12sp"
                android:textColor="@color/colorTextSecondary"
                android:layout_marginBottom="3dp"/>

            <TextView
                android:id="@+id/tvDispensedWeight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dispensed: 80.0g  ·  Consumed: 0.0g  ·  Remaining: 0.0g"
                android:textSize="12sp"
                android:textColor="@color/colorTextSecondary"
                android:maxLines="6"
                android:ellipsize="end"
                android:lineSpacingExtra="1dp"
                android:layout_marginBottom="3dp"/>

            <TextView
                android:id="@+id/tvDeviation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Deviation: Normal"
                android:textSize="11sp"
                android:textColor="@color/colorStatusCompleted"/>

        </LinearLayout>

        <TextView
            android:id="@+id/tvStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="14dp"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="DONE"
            android:textSize="9sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:letterSpacing="0.04"
            android:background="@drawable/badge_completed"
            android:textColor="@color/colorStatusCompleted"/>

    </LinearLayout>

</androidx.cardview.widget.CardView>
