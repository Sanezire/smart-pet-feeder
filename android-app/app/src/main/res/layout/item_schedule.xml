<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardSchedule"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/colorSurface"
    app:strokeWidth="1dp"
    app:strokeColor="@color/colorDivider">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <View
            android:id="@+id/scheduleAccent"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="@color/colorPrimary"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="@dimen/spacing_md"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:id="@+id/tvScheduleTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="08:00"
                    android:textSize="@dimen/text_size_2xl"
                    android:textStyle="bold"
                    android:textColor="@color/colorTextPrimary"
                    android:letterSpacing="-0.01"/>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchScheduleEnabled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

            </LinearLayout>

            <TextView
                android:id="@+id/tvSchedulePortion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/text_80g_per_feeding"
                android:textSize="@dimen/text_size_body_sm"
                android:textColor="@color/colorTextSecondary"
                android:layout_marginBottom="@dimen/spacing_xs"/>

            <TextView
                android:id="@+id/tvScheduleRecommended"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_size_sm"
                android:textStyle="bold"
                android:textColor="@color/colorStatusCompleted"
                android:layout_marginBottom="@dimen/spacing_xs"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/tvScheduleUnapplied"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_warning"
                android:paddingStart="@dimen/spacing_sm"
                android:paddingEnd="@dimen/spacing_sm"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="@string/sync_schedule_badge"
                android:textSize="@dimen/text_size_caption"
                android:textStyle="bold"
                android:textColor="@color/colorStatusMissed"
                android:layout_marginBottom="6dp"
                android:visibility="gone"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:src="@drawable/ic_clock"
                    android:contentDescription="@string/repeat"
                    app:tint="@color/colorTextMuted"
                    android:layout_marginEnd="5dp"/>

                <TextView
                    android:id="@+id/tvScheduleRepeat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/every_day"
                    android:textSize="@dimen/text_size_sm"
                    android:textColor="@color/colorTextMuted"/>

            </LinearLayout>

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeleteSchedule"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="@dimen/spacing_md"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="10dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:icon="@drawable/ic_delete"
            app:iconSize="18dp"
            app:iconTint="@color/colorTextMuted"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:cornerRadius="10dp"
            app:backgroundTint="@android:color/transparent"
            app:strokeWidth="0dp"
            android:contentDescription="@string/delete_schedule"
            style="@style/Widget.MaterialComponents.Button.TextButton"/>

    </LinearLayout>

</androidx.cardview.widget.CardView>
