<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/spacing_2xl"
    android:paddingEnd="@dimen/spacing_2xl"
    android:paddingTop="@dimen/spacing_sm">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/pet_profile_name_label"
        android:textSize="@dimen/text_size_sm"
        android:textStyle="bold"
        android:textColor="@color/colorTextLabel"
        android:layout_marginBottom="@dimen/spacing_sm"/>

    <EditText
        android:id="@+id/etPetName"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_input_field"
        android:inputType="textPersonName|textCapWords"
        android:maxLength="30"
        android:maxLines="1"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingEnd="@dimen/spacing_lg"
        android:textSize="@dimen/text_size_lg"
        android:textColor="@color/colorTextPrimary"
        android:textColorHint="@color/colorTextMuted"
        android:importantForAutofill="no"
        android:layout_marginBottom="@dimen/spacing_lg"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/pet_profile_type_label"
        android:textSize="@dimen/text_size_sm"
        android:textStyle="bold"
        android:textColor="@color/colorTextLabel"
        android:layout_marginBottom="@dimen/spacing_sm"/>

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggleGroupPetType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginBottom="@dimen/spacing_lg"
        app:singleSelection="true"
        app:selectionRequired="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPetDog"
            android:layout_width="120dp"
            android:layout_height="48dp"
            android:text="@string/pet_type_dog"
            style="@style/Widget.SmartPetFeeder.ToggleButton"
            app:icon="@drawable/dog_icon"
            app:iconSize="24dp"
            app:iconPadding="8dp"
            app:iconTint="@color/toggle_btn_text"
            app:iconGravity="textStart"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPetCat"
            android:layout_width="120dp"
            android:layout_height="48dp"
            android:text="@string/pet_type_cat"
            style="@style/Widget.SmartPetFeeder.ToggleButton"
            app:icon="@drawable/cat_icon"
            app:iconSize="24dp"
            app:iconPadding="8dp"
            app:iconTint="@color/toggle_btn_text"
            app:iconGravity="textStart"/>
    </com.google.android.material.button.MaterialButtonToggleGroup>
</LinearLayout>
